# Maintainer: Laércio de Sousa <laercio@sivali.sousa.nom.br>
#
# Builds from the repository this PKGBUILD lives in (the parent of
# $startdir), so `makepkg` in packaging/ packages the working tree as is.

pkgname=pinentry-omarchy
pkgver=0.1.1
pkgrel=1
pkgdesc='GnuPG pinentry that asks through an Omarchy shell dialog styled like the polkit agent'
arch=(x86_64 aarch64)
url='https://github.com/lbssousa/pinentry-omarchy'
license=(MIT)
depends=(gcc-libs glibc pinentry)
makedepends=(cargo)
optdepends=('omarchy: the shell dialog (without it, pinentry-gnome3/pinentry-curses are used)')
options=(!debug)
install=pinentry-omarchy.install

_srcroot() { cd "$startdir/.."; }

prepare() {
  _srcroot
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  _srcroot
  CARGO_TARGET_DIR="$srcdir/target" cargo build --frozen --release
}

check() {
  _srcroot
  CARGO_TARGET_DIR="$srcdir/target" cargo test --frozen --release
}

package() {
  _srcroot
  install -Dm755 "$srcdir/target/release/pinentry-omarchy" "$pkgdir/usr/bin/pinentry-omarchy"
  install -Dm644 -t "$pkgdir/usr/share/pinentry-omarchy/plugin" plugin/manifest.json plugin/*.qml
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
